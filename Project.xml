<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->

	<app package="com.axolstudio.monstermatch" title="Monster Match" file="MonsterMatch" main="Main" version="1.0.5" build-number="26"
		company="Axol Studio, LLC" />

	<!--The flixel preloader is not accurate in Chrome. You can use it regularly if you embed the swf into a html file
		or you can set the actual size of your file manually at "FlxPreloaderBase-onUpdate-bytesTotal"-->
	<!-- <app preloader="flixel.system.FlxPreloader" /> -->

	<!--Minimum without FLX_NO_GAMEPAD: 11.8, without FLX_NO_NATIVE_CURSOR: 11.2-->
	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<!--These window settings apply to all targets-->
	<window width="800" height="600" fps="120" background="#333333" hardware="true" vsync="true" />

	<!--<window borderless="true"/>-->

	<!--HTML5-specific-->
	<window if="html5" width="0" height="0" resizable="true" />

	<!--Desktop-specific-->
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="false" />

	<!--Mobile-specific-->
	<window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" />
	<architecture name="arm64" if="android" />
	<architecture name="x64" if="android" />
	<architecture exclude="armv7" if="android" />
	<config:android minimum-sdk-version="24" target-sdk-version="36" gradle-version="8.11.1" gradle-plugin="8.9.2" if="android" />
	<!-- Lime 8.3 uses legacy Back events; retain them on Android 16. -->
	<config:android if="android">
        <application android:enableOnBackInvokedCallback="false" android:icon="@drawable/monster_launcher" android:roundIcon="@drawable/monster_launcher" />
		<gradle-properties org.gradle.jvmargs="-Xmx1024m" org.gradle.workers.max="2" org.gradle.daemon="false" />
	</config:android>
	<haxeflag name="-dce" value="full" if="android" />
	<haxeflag name="--macro" value="FullIntro.enable()" if="android || full_intro" />
	<include path="extensions/play-games/include.xml" if="android" />

	<window allow-high-dpi="true" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export" unless="ng" />
	<set name="BUILD_DIR" value="export/ng" if="ng" />

	<set name="BUILD_DIR" value="export" />
	<classpath name="source" />
	<classpath name="core" />
	<classpath name="tests" if="text_regression" />
	<classpath name="tests" if="counter_regression" />
	<classpath name="tests" if="bitmap_log_regression" />

	<assets path="assets/images" rename="assets/images" include="*.png|*.xml" embed="true" />
	<assets path="assets/data" rename="assets/data" include="*.json" embed="true" />
	<assets path="assets/music" rename="assets/music" include="*.ogg" embed="true" />
	<assets path="assets/sounds" rename="assets/sounds" include="*.wav" embed="true" />
	<assets path="assets/fonts" rename="assets/fonts" include="*.ttf" embed="true" />


	<!-- _______________________________ Libraries ______________________________ -->

	<include path="axollib/include.xml" />


	<haxelib name="flixel" version="6.1.2" />

	<!--In case you want to use the addons package-->
	<haxelib name="flixel-addons" version="4.0.1" />

	<!-- <haxelib name="axollib" /> -->

	<haxelib name="newgrounds" if="ng" />

	<!--In case you want to use the ui package-->
	<!--<haxelib name="flixel-ui" />-->

	<!--In case you want to use nape with flixel-->
	<!--<haxelib name="nape-haxe4" />-->

	<!-- ______________________________ Haxedefines _____________________________ -->

	<!--Enable the Flixel core recording system-->
	<!--<haxedef name="FLX_RECORD" />-->

	<!--Disable the right and middle mouse buttons-->
	<!--<haxedef name="FLX_NO_MOUSE_ADVANCED" />-->

	<!--Disable the native cursor API on Flash-->
	<!--<haxedef name="FLX_NO_NATIVE_CURSOR" />-->

	<!--Optimise inputs, be careful you will get null errors if you don't use conditionals in your game-->
	<!-- Keep touch, mouse, and keyboard available for Android and ChromeOS. -->
	<haxedef name="FLX_NO_GAMEPAD" />
	<haxedef name="FLX_NO_HEALTH" />

	<!--Disable the Flixel core sound tray-->
	<!--<haxedef name="FLX_NO_SOUND_TRAY" />-->

	<!--Disable the Flixel sound management code-->
	<!--<haxedef name="FLX_NO_SOUND_SYSTEM" />-->

	<!--Disable the Flixel core focus lost screen-->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />

	<!--Disable the Flixel core debugger. Automatically gets set whenever you compile in release mode!-->
	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	<!--Enable this for Nape release builds for a serious peformance improvement-->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />

	<!-- _________________________________ Custom _______________________________ -->

	<!--Place custom nodes like icons here (higher priority to override the HaxeFlixel icon)-->

	<icon path="assets/icons/icon.png" unless="android" />
</project>
